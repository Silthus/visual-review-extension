{
  "name": "posthog-visual-review-extension",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Shows PostHog visual review results at the top of GitHub pull requests.",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "preview": "node scripts/build.mjs && node preview/build.mjs",
    "screenshots": "node scripts/screenshots.mjs",
    "zip": "node scripts/build.mjs && rm -f posthog-visual-review.zip && cd dist && zip -qr ../posthog-visual-review.zip .",
    "build:chrome": "node scripts/build.mjs --browser=chrome",
    "build:firefox": "node scripts/build.mjs --browser=firefox",
    "dev:firefox": "node scripts/build.mjs --browser=firefox --watch",
    "zip:chrome": "pnpm zip",
    "zip:firefox": "node scripts/build.mjs --browser=firefox && rm -f posthog-visual-review-firefox.zip && cd dist-firefox && zip -qr ../posthog-visual-review-firefox.zip ."
  },
  "dependencies": {
    "@posthog/brand": "^0.12.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.0",
    "@types/jsdom": "^30.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  },
  "packageManager": "pnpm@10.33.2"
}
